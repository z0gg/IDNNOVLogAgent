#!/bin/sh
# Locate a usable Python 3 without declaring a DSM package dependency.
# Forward every argument to the selected interpreter.
for c in \
  /usr/bin/python3 \
  /var/packages/Python3.9/target/usr/bin/python3 \
  /var/packages/Python3.9/target/usr/bin/python3.9 \
  /var/packages/Python3.9/target/usr/local/bin/python3 \
  /var/packages/python39/target/usr/local/bin/python3 \
  /var/packages/python310/target/usr/local/bin/python3 \
  /var/packages/python311/target/usr/local/bin/python3 \
  /var/packages/python312/target/usr/local/bin/python3 \
  /var/packages/python313/target/usr/local/bin/python3 \
  /var/packages/python314/target/usr/local/bin/python3; do
  if [ -x "$c" ]; then exec "$c" "$@"; fi
done
echo "no compatible python3 interpreter found" >&2
exit 127
